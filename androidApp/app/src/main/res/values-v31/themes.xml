<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash (it can't be skipped) shows the Dorr mark in its circle on the plain background —
         light or dark by the phone's mode (values-night) — not the launcher icon on white. -->
    <style name="Theme.Dorr.Splash" parent="Theme.Dorr">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
