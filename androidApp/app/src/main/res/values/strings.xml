    <!-- FAQ -->
    <string name="faq_title">FAQs</string>
    <string name="faq_q1">How do I edit my personal data?</string>
    <string name="faq_a1">Open Account → Personal Data, update your details, then tap Save.</string>
    <string name="faq_q2">How do I switch the app language?</string>
    <string name="faq_a2">Open Account → Language and pick Arabic or English.</string>
    <string name="faq_q3">Does the app support dark mode?</string>
    <string name="faq_a3">Yes — toggle it from Account → Dark Mode.</string>
    <string name="faq_q4">How do I reach support?</string>
    <string name="faq_a4">Open Account → Contact Us for phone, WhatsApp and email options.</string>

