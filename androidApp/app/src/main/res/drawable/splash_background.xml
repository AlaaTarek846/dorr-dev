<?xml version="1.0" encoding="utf-8"?>
<!-- The splash window before Android 12 (and the window behind every screen on every version): the plain background
     with splash_icon in the middle — one ready image, 288dp, of the 160dp circle (#FDF1EC by day, #1F2937 by night)
     and the Dorr mark at 96dp — the same picture the Android 12+ splash and the app's own splash start from. Colours
     and image follow light / dark (values-night, drawable-night-*dpi).
     Only plain layers here, never an <inset>: a window background's padding (its insets) is applied to the whole
     window — every screen was squeezed into a box in the middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_bg" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap android:src="@drawable/splash_icon" android:gravity="center" />
    </item>
</layer-list>
