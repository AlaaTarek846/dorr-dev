<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Chat: contacts sync, voice notes + calls, video calls, "send my location", call ringing. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Push (Android 13+) and unlocking locked chats with a fingerprint / face / PIN. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Incoming calls: the ringing page over the lock screen, waking the display. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Chat live location: keeps sending the position (with a visible notification) until it ends. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".DorrApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dorr"
        android:usesCleartextTraffic="true">
        <!-- Cleartext (plain HTTP) is needed for local dev against Laragon
             (dorr.test / 10.0.2.2 have no TLS). Remove this once the API is
             served over HTTPS, or scope it with a network security config
             that only allows cleartext for the dev host. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dorr.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Incoming call ringing page (opened by the call notification's full-screen intent). -->
        <activity
            android:name=".chat.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="com.dorr.app.call"
            android:theme="@style/Theme.Dorr" />

        <!-- "Decline" button on the call notification. -->
        <receiver
            android:name=".chat.CallActionReceiver"
            android:exported="false" />

        <!-- Live location sharing in the chat (15 min / 1 h / 8 h). -->
        <service
            android:name=".chat.LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Every push passes through here first: calls become a ringing call, not a banner. -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="com.dorr.app.chat.ChatNotificationExtension" />
    </application>

</manifest>
