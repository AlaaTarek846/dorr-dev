<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AR is optional: phones without ARCore still install the app; the editor then explains it cannot run. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application>
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <activity android:name="com.dorr.ar.editor.ArEditorActivity" android:exported="false" android:screenOrientation="portrait" />
    </application>
</manifest>
