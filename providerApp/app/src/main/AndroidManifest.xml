<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications (Android 13+): asked for once, after the first screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A paper photographed with the camera (asked for only when "camera" is chosen); a phone without one still installs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- The main branch's place at sign-up (asked for only when "use my current location" is tapped). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The truck's position while a driver's job runs, in a foreground service. No background-location permission: the service
         starts while the app is in front, and "while using the app" is enough for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:name=".ProviderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DorrProvider"
        android:usesCleartextTraffic="true">
        <!-- Cleartext (plain HTTP) is for a developer's LAN backend (a bare IP has no TLS), like androidApp.
             Remove it, or scope it to the dev host, once every build talks HTTPS. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DorrProvider.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".duty.MoveTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Hands the camera a place to write a paper's photo, and a viewer the downloaded receipt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
