<?xml version="1.0" encoding="utf-8"?>
<!-- The same soft glow as the Compose splash (PinkBackdrop), so the first frame does not flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="440dp"
                android:centerX="0.5"
                android:centerY="0"
                android:startColor="#33001B53"
                android:endColor="#00001B53" />
        </shape>
    </item>
</layer-list>
