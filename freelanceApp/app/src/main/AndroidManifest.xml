<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications (Android 13+): asked for once, after the first screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The profile photo from the camera (asked for only when "camera" is chosen); a phone without one still installs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".FreelanceApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DorrFreelance"
        android:usesCleartextTraffic="true">
        <!-- Cleartext (plain HTTP) is for a developer's LAN backend (a bare IP has no TLS), like androidApp.
             Remove it, or scope it to the dev host, once every build talks HTTPS. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DorrFreelance.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera a place to write the profile photo. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

</manifest>
