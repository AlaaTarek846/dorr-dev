<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleDisplayName</key>
	<string>Dorr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- dorr://chat/… links (click to chat, invites, call links) and dorr://sports/… from the widgets. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dorr</string>
			</array>
		</dict>
	</array>
	<key>DorrApiHost</key>
	<string>$(DORR_API_HOST)</string>
	<key>DorrApiScheme</key>
	<string>$(DORR_API_SCHEME)</string>
	<key>DorrGoogleMapsKey</key>
	<string>$(DORR_GOOGLE_MAPS_KEY)</string>
	<key>NSContactsUsageDescription</key>
	<string>To show which of your contacts are on DORR so you can chat with them.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>To say where you're going instead of typing it, and to send voice notes to DORR AI.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To turn what you say into text for DORR AI.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>To show where you are on the map and set your pickup point.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Dev: the LAN IP / dorr.test backend is plain HTTP, like Android's cleartext allowance. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Cairo.ttf</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Open your Dorr wallet with Face ID instead of typing the PIN.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan a wallet QR code, take a selfie to unlock a frozen wallet, or place DORR AR models in your room.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save your wallet QR code to your photos.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
