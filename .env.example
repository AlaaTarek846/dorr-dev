APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Proxies whose X-Forwarded-For is trusted for the caller IP (ngrok locally: 127.0.0.1,::1; "*" = any)
TRUSTED_PROXIES=
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dorr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# v2.0 requirements doc S15.3: real-time push of the final AI chat reply.
# Leave AI_CHAT_BROADCAST_ENABLED=false (the default) until Reverb is
# actually installed and running - php artisan reverb:start, then set
# BROADCAST_CONNECTION=reverb above and fill these in (reverb:install
# would normally generate REVERB_APP_ID/KEY/SECRET for you).
AI_CHAT_BROADCAST_ENABLED=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/user/google/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/user/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

AUTH_OTP_LENGTH=4
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN=60
AUTH_FLOW_TOKEN_EXPIRY_MINUTES=60

# Optional, local only: if set, the AI module seeder saves this as the
# Groq provider's API key and enables it. Leave empty to skip.
AI_GROQ_SEED_API_KEY=

# ════════════════════════════════════════════════════════════════════════════
# 🌐 بناء المواقع بالذكاء الاصطناعي واستضافتها (Modules/AI)
# ════════════════════════════════════════════════════════════════════════════
# مهم قبل التشغيل:
#  1) نفّذ: php artisan migrate   (فيه جداول جديدة للمواقع والاستضافة والفيديو).
#  2) لازم الـ Queue Worker يكون شغّال، لأن بناء الموقع بيتم في الخلفية:
#       php artisan queue:work --timeout=900
#     وعلى الشيرد هوست (من غير SSH) حط في الـ Cron كل دقيقة:
#       * * * * * php /مسار/المشروع/artisan schedule:run >> /dev/null 2>&1
#     وكمان كرون لتشغيل الـ queue:
#       * * * * * php /مسار/المشروع/artisan queue:work --stop-when-empty --timeout=900
#     (الـ schedule:run هو اللي بيجدد الاستضافة وبيوقف المواقع المنتهية كل ساعة).
#  3) QUEUE_CONNECTION فوق لازم يفضل database (أو redis) - مش sync.
#  4) موديل الـ coding اللي هيبني المواقع (من لوحة الأدمن > الموديلات) لازم
#     يكون max_tokens بتاعه 16000 على الأقل، لأن إعداد الموديل بيغلب إعداد هنا.

# تشغيل/إيقاف ميزة بناء المواقع كلها (true/false).
AI_SITES_ENABLED=true

# دومين مخصص لعرض روابط المعاينة (اختياري، موصى بيه في الإنتاج).
# فاضي = المعاينة بتشتغل على نفس موقعك تحت المسار /ai-sites/ وده آمن لكن العزل أضعف.
# مثال: AI_SITES_DOMAIN=preview.dorrsites.com  (لازم يشاور على نفس مجلد public).
AI_SITES_DOMAIN=

# أقصى عدد tokens يطلبه الموقع الواحد من الموديل (المواقع الكبيرة تحتاج رقم كبير).
AI_SITES_MAX_OUTPUT_TOKENS=16000

# أقصى وقت (بالثواني) ننتظر فيه رد الموديل وهو بيبني الموقع. بناء الموقع أبطأ من الشات.
AI_SITES_REQUEST_TIMEOUT=600

# بعد كام دقيقة نعتبر البناء/التعديل العالق (الـ worker واقف مثلًا) فاشل تلقائيًا: النسخة القديمة تفضل شغالة
# والعميل يقدر يجرب تاني، ولو دافع بتتردله المحاولة. بيشتغل من الـ scheduler (cron: schedule:run).
AI_SITES_STALE_AFTER_MINUTES=30

# مهم جدًا لو QUEUE_CONNECTION=database: لازم الرقم ده يبقى أكبر من أقصى وقت لبناء موقع (900 ثانية).
# لو سيبته الافتراضي (90) المهمة الطويلة بترجع للطابور وهي لسه شغالة، فبيتبني الموقع مرتين أو بيفشل.
# بعد ما تغيّره لازم توقف الـ queue worker وتشغله من جديد (php artisan queue:work).
DB_QUEUE_RETRY_AFTER=1000

# حدود أمان للموقع المولّد (لو الموديل عدّاها الموقع بيترفض):
AI_SITES_MAX_FILES=30              # أقصى عدد ملفات في الموقع
AI_SITES_MAX_FILE_BYTES=600000     # أقصى حجم للملف الواحد بالبايت (~600KB)
AI_SITES_MAX_TOTAL_BYTES=3000000   # أقصى حجم للموقع كله بالبايت (~3MB)

# حجم كود الموقع الحالي (بالبايت) اللي بنبعته للموديل وقت طلب تعديل. أكبر منه يتقطع.
AI_SITES_EDIT_CONTEXT_BYTES=150000

# أقصى عدد نسخ (versions) للموقع الواحد، كل بناء/تعديل/استرجاع بيعمل نسخة.
AI_SITES_MAX_VERSIONS=30

# ─── استضافة المواقع (اشتراك شهري/سنوي بيتسعّر من لوحة التحكم) ───────────────
# تشغيل/إيقاف الاستضافة.
AI_SITES_HOSTING_ENABLED=true

# دومين الاستضافة: كل عميل بياخد اسم.الدومين-ده (مثال: ahmed.dorrsites.com).
#  • الأفضل دومين منفصل عن دومين دورر الأساسي (عشان الأمان وسمعة الدومين).
#  • على الشيرد هوست: حط الدومين على Cloudflare (مجاني) عشان الشهادة تغطي *.الدومين،
#    وأضف سجل DNS من نوع A باسم * يشاور على IP الاستضافة (Proxied)،
#    وفي cPanel اعمل Wildcard Subdomain (*) يشاور على مجلد public بتاع المشروع.
#  • فاضي = "وضع المسار": المواقع بتشتغل على موقعك تحت /sites/اسم-العميل
#    من غير أي إعداد DNS (مناسب لو الاستضافة مش بتدعم wildcard).
# مثال: AI_SITES_HOSTING_DOMAIN=dorrsites.com
AI_SITES_HOSTING_DOMAIN=

# بروتوكول الروابط المعروضة للعميل (https في الإنتاج).
AI_SITES_HOSTING_SCHEME=https

# المسار المستخدم في "وضع المسار" فقط (لما AI_SITES_HOSTING_DOMAIN فاضي).
# ملحوظة: غيّره قبل ما أول عميل ياخد رابط، لأن الروابط القديمة هتتغير.
AI_SITES_HOSTING_PATH_PREFIX=sites

# أيام السماح بعد انتهاء الاشتراك لو فشل التجديد من المحفظة (الموقع يفضل شغال).
AI_SITES_HOSTING_GRACE_DAYS=3

# بعد كام يوم من إيقاف الموقع (انتهاء السماح) يتحذف الحجز ويتحرر الاسم لعميل تاني.
AI_SITES_HOSTING_DELETE_AFTER_DAYS=30

# مدة الكاش (بالثواني) للمواقع المنشورة في المتصفح/Cloudflare. أقل = التعديلات تظهر أسرع.
AI_SITES_HOSTING_CACHE_SECONDS=120

# أسماء إضافية ممنوعة على العملاء (مفصولة بفاصلة)، فوق القائمة الجاهزة
# (admin, api, login, paypal, dorr ... إلخ). مثال: AI_SITES_HOSTING_RESERVED=vodafone,cib,nbe
AI_SITES_HOSTING_RESERVED=

# ════════════════════════════════════════════════════════════════════════════
# 🎬 توليد الفيديو في الشات (Modules/AI)
# ════════════════════════════════════════════════════════════════════════════
# حدود الاستخدام لكل باقة (عدد الفيديوهات يومياً وأقصى مدة) بتتظبط من لوحة الأدمن > الباقات.
# الموديلات: بنستخدم Google Veo (لازم مزوّد Google مفعّل ومعاه API key من لوحة الأدمن).
# محتاج Queue Worker شغّال (نفس ملاحظات فوق).

# تشغيل/إيقاف توليد الفيديو بالكامل.
AI_VIDEO_ENABLED=true

# مقاس الفيديو (لـ OpenAI) ونسبة الأبعاد (لـ Google Veo): 16:9 عرضي، 9:16 طولي.
AI_VIDEO_SIZE=1280x720
AI_VIDEO_ASPECT_RATIO=16:9

# المدة الافتراضية بالثواني لو العميل ما حددش، ولو الموديل بيدعم المدة دي.
AI_VIDEO_DEFAULT_SECONDS=4

# كل كام ثانية نسأل المزوّد "الفيديو جاهز؟"، وأقصى انتظار (بالثواني) قبل ما نعتبره فشل.
AI_VIDEO_POLL_INTERVAL=15
AI_VIDEO_TIMEOUT=900

# أقصى وقت (بالثواني) لتحميل ملف الفيديو الجاهز من المزوّد.
AI_VIDEO_DOWNLOAD_TIMEOUT=180

# OpenAI أوقف Sora API يوم 2026-09-24، فخليه false. لو رجّعوه وعايز تجرّبه خليه true.
AI_OPENAI_VIDEO_ENABLED=false

# Wallet module: mixed into every wallet PIN hash (Modules/Wallet).
WALLET_PIN_PEPPER=

# Wallet payment gateways — pre-fill payment_methods.credentials on a fresh
# seed only (Modules/Wallet PaymentMethodSeeder). Leave a gateway's values
# empty and it is seeded inactive; real values are managed from the admin
# dashboard afterwards (stored encrypted in the database).
MYFATOORAH_API_URL=
MYFATOORAH_API_KEY=
ARB_TRANPORTAL_ID=
ARB_TRANPORTAL_PASSWORD=
ARB_TRANPORTAL_RESOURCE_KEY=
ARB_TRANPORTAL_HOSTED_URL=
URPAY_MODE=test
URPAY_PAYMENT_URL=
URPAY_USERNAME=
URPAY_PASSWORD=
URPAY_CLIENT_ID=
URPAY_TERMINAL_ID=
URPAY_MERCHANT_WALLET_NUMBER=
URPAY_MERCHANT_ID=
URPAY_TEST_CONSUMER_MOBILE_NUMBER=

# ─── Pusher / Soketi (Real-time Notifications) ─────────────────────────────
# Set BROADCAST_CONNECTION=pusher to enable real-time broadcasting.
# For local dev install Soketi and use the values below (host/port/scheme).
# Chat calls (LiveKit Cloud today, self-hosted later — only these change). docs/modules/chat/README.md
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Call recordings (spec 92): a private S3-compatible bucket LiveKit Egress writes into. Empty = no "record" button.
# Non-AWS (R2, Spaces, MinIO): set the https endpoint and PATH_STYLE=true (R2: REGION=auto).
CHAT_RECORDINGS_KEY=
CHAT_RECORDINGS_SECRET=
CHAT_RECORDINGS_REGION=us-east-1
CHAT_RECORDINGS_BUCKET=
CHAT_RECORDINGS_ENDPOINT=
CHAT_RECORDINGS_PATH_STYLE=false

# Chat GIFs + animated stickers library (https://developers.giphy.com). Empty = only Dorr sticker packs.
GIPHY_API_KEY=
GIPHY_RATING=pg-13

# DORR Sports: API-Sports key (api-football.com dashboard). Free plan = 100 requests/day.
API_SPORTS_KEY=
API_SPORTS_DAILY_LIMIT=100

# Rides (Modules/Rides): Google Maps Platform server key — Routes API (+ Places / Geocoding later).
# Server only; the apps never receive it. Restrict it to the server's IP in Google Cloud.
GOOGLE_MAPS_SERVER_KEY=
# Mapbox — picked instead of Google in admin → Rides → Settings (the token there wins over this one).
# A public pk. token: the server's routes / city names and the apps' map both use it.
MAPBOX_TOKEN=
CHAT_CALL_RING_TIMEOUT_SECONDS=45

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Empty = Pusher's own cloud (api-<cluster>.pusher.com). Only for a self-hosted Soketi set
# PUSHER_HOST / PORT / SCHEME — never 127.0.0.1 on a live server: phones can't reach it and
# the chat goes silent (check with `php artisan chat:realtime-check`).
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# ─── OneSignal (Push Notifications) ────────────────────────────────────────
# Used by sendPushNotification() helper — no extra Composer package required.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_GUZZLE_CLIENT_TIMEOUT=10
# The captain app's own OneSignal app (optional — empty = it shares the app above)
ONESIGNAL_DRIVER_APP_ID=
ONESIGNAL_DRIVER_REST_API_KEY=

# Development only: fixed 4-digit e-mail code (leave empty in production).
AUTH_EMAIL_OTP_FIXED=

# ════════════════════════════════════════════════════════════════════════════
# 🌍 DORR AI WORLD + 🥽 AR (Modules/AI) — فيديو السفر، المواقع، الواقع المعزز
# ════════════════════════════════════════════════════════════════════════════

# مفتاح Google Maps Platform (للسيرفر فقط، التطبيقات ما بتشوفوش أبدًا).
# بيستخدمه البحث عن الأماكن والمعالم (Places API New - places:searchText).
# إزاي تجيبه: console.cloud.google.com > APIs & Services > Library >
# فعّل "Places API (New)" > Credentials > Create API key، وقيّده
# (Restrict key) على Places API + على IP السيرفر. لازم Billing يكون مفعّل
# (فيه رصيد مجاني شهري). لو فاضي: البحث بيرجع للكتالوج الجاهز (42 معلم) بس.
GOOGLE_MAPS_API_KEY=

# أقصى وقت (ثواني) للانتظار على رد Google Places قبل ما الطلب يفشل.
AI_WORLD_PLACES_TIMEOUT=10

# مدة تخزين نتيجة البحث مؤقتًا (ثواني). 86400 = يوم. بيوفر تكلفة طلبات Google
# لأن نفس البحث المتكرر ما بيتحاسبش تاني.
AI_WORLD_SEARCH_CACHE_TTL=86400

# الجولة التفاعلية 3D (Google 3D Tiles). سيبها false لحد ما مرحلة الـ 3D تتبني
# وتتأكد من الترخيص. true قبل كده مالهاش تأثير مفيد.
AI_WORLD_TILES_ENABLED=false

# ملاحظات مهمة (مش متغيرات):
# • مفتاح Gemini / Veo (توليد الفيديو): ما بيتحطش هنا. بيتحط من لوحة الأدمن
#   > AI > Providers > Google > API Key (بيتخزن مشفّر في الداتابيز) ثم فعّل
#   الموديل veo-3.1-fast. لازم حساب Gemini API فيه Billing.
# • FFmpeg لازم يكون متثبّت على السيرفر (لدمج مشاهد الفيديو). لو مش في الـ PATH
#   حط مساره في AI_VIDEO_FFMPEG_PATH و AI_VIDEO_FFPROBE_PATH (موجودين أعلاه/في
#   إعدادات الفيديو). على Laragon: C:\laragon\bin\ffmpeg\ffmpeg.exe مثلًا.
# • الـ Queue worker لازم شغال (php artisan queue:work) وإلا الفيديو مش هيكمل.
# • AWS Rekognition (فحص الوجوه) هيتضاف مفاتيحه في مرحلة الهوية لاحقًا.

# AWS Rekognition (فحص تشابه الوجه بين الصور المرجعية والفيديو). اتركها فاضية لإيقاف الفحص.
# إزاي: AWS Console > IAM > Users > Create user بصلاحية rekognition:CompareFaces فقط > Security credentials > Create access key.
# المنطقة الأقرب لك (eu-west-1 أيرلندا / me-south-1 البحرين). التكلفة تقريبًا $0.001 للصورة المقارنة.
AI_WORLD_AWS_KEY=
AI_WORLD_AWS_SECRET=
AI_WORLD_AWS_REGION=eu-west-1
AI_WORLD_AWS_TIMEOUT=20
# أقصى حجم لصورة الشخص بالبايت (8MB افتراضيًا).
AI_WORLD_MAX_PHOTO_BYTES=8388608

# DORR AI WORLD: burn a small visible "DORR AI WORLD" label into every finished trip video (needs FFmpeg built with drawtext).
# If the label step fails, the video is still delivered without it. Font path: use C\:/ with a backslash before the colon on Windows.
AI_WORLD_BURN_LABEL=true
AI_WORLD_LABEL_FONT=C\:/Windows/Fonts/arialbd.ttf
# Wasl (TGA via ELM) — passenger rides in Saudi Arabia (docs/rides-plan.md §11)
WASL_HOSTED_URL=https://rabet-wasl.api.elm.sa/api
WASL_APP_ID=
WASL_APP_KEY=
WASL_CLIENT_ID=
RIDES_REGULATOR_ENFORCED=true
