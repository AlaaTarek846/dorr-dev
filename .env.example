APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dorr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/user/google/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/user/apple/callback"
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN=60
AUTH_FLOW_TOKEN_EXPIRY_MINUTES=60

# Optional, local only: if set, the AI module seeder saves this as the
# Groq provider's API key and enables it. Leave empty to skip.
AI_GROQ_SEED_API_KEY=

# Wallet module: mixed into every wallet PIN hash (Modules/Wallet).
WALLET_PIN_PEPPER=

# Wallet payment gateways — pre-fill payment_methods.credentials on a fresh
# seed only (Modules/Wallet PaymentMethodSeeder). Leave a gateway's values
# empty and it is seeded inactive; real values are managed from the admin
# dashboard afterwards (stored encrypted in the database).
MYFATOORAH_API_URL=
MYFATOORAH_API_KEY=
ARB_TRANPORTAL_ID=
ARB_TRANPORTAL_PASSWORD=
ARB_TRANPORTAL_RESOURCE_KEY=
ARB_TRANPORTAL_HOSTED_URL=
URPAY_MODE=test
URPAY_PAYMENT_URL=
URPAY_USERNAME=
URPAY_PASSWORD=
URPAY_CLIENT_ID=
URPAY_TERMINAL_ID=
URPAY_MERCHANT_WALLET_NUMBER=
URPAY_MERCHANT_ID=
URPAY_TEST_CONSUMER_MOBILE_NUMBER=

# ─── Pusher / Soketi (Real-time Notifications) ─────────────────────────────
# Set BROADCAST_CONNECTION=pusher to enable real-time broadcasting.
# For local dev install Soketi and use the values below (host/port/scheme).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# ─── OneSignal (Push Notifications) ────────────────────────────────────────
# Used by sendPushNotification() helper — no extra Composer package required.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_GUZZLE_CLIENT_TIMEOUT=10
