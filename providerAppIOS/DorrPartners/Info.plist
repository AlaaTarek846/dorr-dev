<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DorrApiHost</key>
	<string>$(DORR_API_HOST)</string>
	<key>DorrApiScheme</key>
	<string>$(DORR_API_SCHEME)</string>
	<key>DorrGoogleMapsKey</key>
	<string>$(DORR_GOOGLE_MAPS_KEY)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Dev: the LAN IP / dorr.test backend is plain HTTP, like Android's cleartext allowance. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Cairo.ttf</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Open your establishment's wallet with Face ID instead of typing the PIN.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos of your establishment's papers and the pieces you move, and scan the customer's delivery code.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick pictures of your establishment's papers and the pieces you move.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Open the map where you are to place your branch, and let the customer follow the truck while your moving job runs.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Let the customer follow the truck while your moving job runs, even with the app in the background.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
